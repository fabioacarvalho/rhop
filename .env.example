# Copie este arquivo para `.env` e preencha com suas credenciais locais.
# Nunca commite o `.env` real — apenas este template.

# Connection string do Postgres (Supabase). Usada pelo Prisma (lib/prisma.ts, prisma.config.ts).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# URL pública do projeto Supabase. Usada pelos clients de browser/server (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anônima (pública) do Supabase, usada no client de browser para autenticação.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do Supabase (privilégios administrativos) — uso SOMENTE server-side (nunca expor ao client).
SUPABASE_SERVICE_ROLE_KEY=

# API key da OpenAI, usada para gerar resumo_ia e insights agregados. Uso SOMENTE server-side.
OPENAI_API_KEY=

# API key do Resend, usada para envio de e-mails (notificações de aprovação/pendência).
RESEND_API_KEY=

# Token simples para proteger o endpoint de cron de verificação de SLA.
CRON_SECRET=

# Repositório de destino (owner/repo) onde o botão de ajuda cria a issue via API do GitHub.
GITHUB_REPO=fabioacarvalho/rhop

# Personal Access Token (fine-grained) com escopo "Issues: write" restrito a GITHUB_REPO.
# Uso SOMENTE server-side (lib/services/githubService.ts) — nunca expor ao client.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=